# Copy this file to .env and fill in your own values

# PostgreSQL connection
DATABASE_URL=postgresql://scimly_user:scimly_pass@localhost:5432/scimly_db

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Phase 12 — Authentication
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=20160

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Create OAuth credentials at:
#  Google: https://console.cloud.google.com/apis/credentials
#          (Authorized redirect URI: <BACKEND_URL>/api/auth/google/callback)
#  GitHub: https://github.com/settings/developers
#          (Authorization callback URL: <BACKEND_URL>/api/auth/github/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 13 — Large Dataset Support
# Files >= LARGE_FILE_THRESHOLD_BYTES are analyzed in the background by a
# Celery worker instead of on the upload request itself.
LARGE_FILE_THRESHOLD_BYTES=104857600
MAX_FILE_SIZE_BYTES=1073741824
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
